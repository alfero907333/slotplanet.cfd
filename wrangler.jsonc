{
  "main": "dist/_worker.js/index.js",
  "name": "",
  "compatibility_date": "2026-02-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SITE_NAME": "CRACKSTREAMS",
    "API": "https://panel.sportsmerge.org/api/v1",
    "PUBLIC_BASE_URL": "https://astro-react-streaming-site.pages.dev"
  }
}
