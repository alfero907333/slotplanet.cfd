---
import Layout from "../../../../layouts/Layout.astro";

const { eventSlug, eventId } = Astro.params;
const API = import.meta.env.API;
const SITE_NAME = import.meta.env.SITE_NAME;

let data;

// Fetch event data
try {
  const res = await fetch(
    `https://spanelv2.andrhino.com/api/v2/schedule/${eventId}`,
  );

  if (res.status === 404) {
    // Trigger Astro 404 page
    throw new Response("Event not found", { status: 404 });
  }

  if (!res.ok) {
    throw new Response(`API Error: ${res.status}`, { status: 500 });
  }

  data = await res.json();

  if (!data.id) {
    return new Response(null, { status: 404, statusText: "Not Found" });
  }
} catch (err: any) {
  // Catch network errors or thrown Responses
  if (err instanceof Response) throw err;
  throw new Response(err.message, { status: 500 });
}

// return new Response(null, { status: 404, statusText: 'Not Found' });

const {
  date_time,
  league,
  strHomeTeam,
  strAwayTeam,
  title,
  frames,
  teams,
  event_date_time,
} = data;

// Handle missing names
const displayHome = strHomeTeam || (teams?.includes(' vs ') ? teams.split(' vs ')[0] : (teams?.includes(' VS ') ? teams.split(' VS ')[0] : teams));
const displayAway = strAwayTeam || (teams?.includes(' vs ') ? teams.split(' vs ')[1] : (teams?.includes(' VS ') ? teams.split(' VS ')[1] : ''));

// Basic translations for time, date, and sports terms
const translateSportsData = (str: string) => {
  if (!str) return str;
  
  let translated = str;
  
  // Keep everything in English
  return translated;
};

export const prerender = false;
