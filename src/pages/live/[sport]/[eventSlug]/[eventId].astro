---
import Layout from "../../../../layouts/Layout.astro";

const { eventSlug, eventId } = Astro.params;
const API = import.meta.env.API;
const SITE_NAME = import.meta.env.SITE_NAME;

let data;

// Fetch event data
try {
  const res = await fetch(
    `https://spanelv2.andrhino.com/api/v2/schedule/${eventId}`,
  );

  if (res.status === 404) {
    // Trigger Astro 404 page
    throw new Response("Event not found", { status: 404 });
  }

  if (!res.ok) {
    throw new Response(`API Error: ${res.status}`, { status: 500 });
  }

  data = await res.json();

  if (!data.id) {
    return new Response(null, { status: 404, statusText: "Not Found" });
  }
} catch (err: any) {
  // Catch network errors or thrown Responses
  if (err instanceof Response) throw err;
  throw new Response(err.message, { status: 500 });
}

// return new Response(null, { status: 404, statusText: 'Not Found' });

const {
  date_time,
  league,
  strHomeTeam,
  strAwayTeam,
  title,
  frames,
  teams,
  event_date_time,
} = data;

// Handle missing names
const displayHome = strHomeTeam || (teams?.includes(' vs ') ? teams.split(' vs ')[0] : (teams?.includes(' VS ') ? teams.split(' VS ')[0] : teams));
const displayAway = strAwayTeam || (teams?.includes(' vs ') ? teams.split(' vs ')[1] : (teams?.includes(' VS ') ? teams.split(' VS ')[1] : ''));

// Basic translations for time, date, and sports terms
const translateSportsData = (str: string) => {
  if (!str) return str;
  
  let translated = str;
  
  // Keep everything in English
  return translated;
};

const cleanTeams = translateSportsData(teams);
const cleanLeague = translateSportsData(league);

let pageTitle = `${cleanTeams} Live Stream - Rojadirecta, Footybite & Methstreams`;
if (pageTitle.length > 60) {
  pageTitle = `${cleanTeams} Live - Rojadirecta & Footybite`.slice(0, 60);
}

let pageDesc = `Watch ${cleanTeams} live on Methstreams, Rojadirecta & Buffstreams. HD sports streaming with no signup. Best live football experience in 2026.`;
if (pageDesc.length > 160) {
  pageDesc = `Watch ${cleanTeams} live on Methstreams & Rojadirecta. Free HD Buffstreams, no signup required. The best sports streaming online in 2026.`.slice(0, 160);
}

export const prerender = false;
---

<Layout
  title={pageTitle}
  description={pageDesc}
  keywords={`Rojadirecta, FootyBite, Soccer Streams, ${cleanTeams} live, ${cleanLeague} stream`}
>
  <!-- Full Left Ad -->
  <div class="fixed left-2 top-1/2 -translate-y-1/2 z-50 hidden xl:block">
    <script is:inline>
      atOptions = {
        'key' : '6a5a027902a4642e7f792ba4488f97cd',
        'format' : 'iframe',
        'height' : 600,
        'width' : 160,
        'params' : {}
      };
    </script>
    <script is:inline src="https://www.highperformanceformat.com/6a5a027902a4642e7f792ba4488f97cd/invoke.js"></script>
  </div>

  <div class="pt-10 px-4 max-w-3xl mx-auto text-left">
    <div
      class="space-y-6 text-center relative p-6 sm:p-8 rounded-2xl theme-card border border-white/10 shadow-2xl backdrop-blur-md"
    >
      <!-- Page Title -->
      <div
        class="text-2xl sm:text-4xl font-black theme-text-primary animate-fadeIn wrap-break-word leading-tight"
      >
        {translateSportsData(teams)}
      </div>

