        >
          Watch Live Now
        </a>
      </div>

      <!-- Mobile Bottom Ad -->
      <div class="flex justify-center w-full mt-8 xl:hidden">
        <div class="theme-card p-2 rounded border border-[var(--border-color)] shadow-sm overflow-hidden">
          <script is:inline>
            atOptions = {
              'key' : '6a5a027902a4642e7f792ba4488f97cd',
              'format' : 'iframe',
              'height' : 50,
              'width' : 320,
              'params' : {}
