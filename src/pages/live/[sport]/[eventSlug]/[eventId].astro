---
import Layout from "../../../../layouts/Layout.astro";

const { eventSlug, eventId } = Astro.params;
const API = import.meta.env.API;
const SITE_NAME = import.meta.env.SITE_NAME;

let data;

// Fetch event data
try {
  const res = await fetch(
    `https://spanelv2.andrhino.com/api/v2/schedule/${eventId}`,
  );

  if (res.status === 404) {
    // Trigger Astro 404 page
    throw new Response("Event not found", { status: 404 });
  }

  if (!res.ok) {
    throw new Response(`API Error: ${res.status}`, { status: 500 });
  }

  data = await res.json();

  if (!data.id) {
    return new Response(null, { status: 404, statusText: "Not Found" });
  }
} catch (err: any) {
  // Catch network errors or thrown Responses
  if (err instanceof Response) throw err;
  throw new Response(err.message, { status: 500 });
}

// return new Response(null, { status: 404, statusText: 'Not Found' });

const {
  date_time,
  league,
  strHomeTeam,
  strAwayTeam,
  title,
  frames,
  teams,
  event_date_time,
} = data;

// Basic translations for time, date, and sports terms
const translateSportsData = (str: string) => {
  if (!str) return str;
  
  let translated = str;
  
  // Keep everything in English
  return translated;
};

export const prerender = false;
---

<Layout
  title={`${translateSportsData(strHomeTeam)} vs ${translateSportsData(strAwayTeam)} – Soccer100`}
  description={`Watch ${translateSportsData(strHomeTeam)} vs ${translateSportsData(strAwayTeam)} live free on Soccer100. HD soccer streams for ${translateSportsData(league)} – no signup needed.`}
  keywords="soccer100, soccer streams"
>
  <div class="pt-10 px-4 max-w-3xl mx-auto text-left">
    <div
      class="space-y-6 text-center relative p-6 sm:p-8 rounded-2xl theme-card border border-white/10 shadow-2xl backdrop-blur-md"
    >
      <!-- Page Title -->
      <div
        class="text-2xl sm:text-4xl font-black theme-text-primary animate-fadeIn wrap-break-word leading-tight"
      >
        {translateSportsData(teams)}
      </div>

      <!-- League and Date Info -->
      <div
        class="flex flex-col sm:flex-row justify-center items-center gap-3 text-sm theme-text-secondary mt-2 animate-fadeIn"
      >
        <span class="px-4 py-1.5 rounded-full bg-[#f3a833] font-black text-black shadow-md uppercase tracking-wider"
          >{translateSportsData(league)}</span
        >
        <span class="sm:ml-2 font-medium theme-card px-3 py-1.5 rounded-full border border-white/5">
          • {translateSportsData(event_date_time)} ET
        </span>
      </div>

      <div class="flex justify-center w-full mt-10">
        <a
          href="play"
          rel="nofollow"
          class="inline-block w-full! sm:w-auto px-8 py-4 bg-[#f3a833] text-black font-black rounded-xl text-xl transition-all hover:bg-[#e29722] hover:scale-105 shadow-[0_0_20px_rgba(243,168,51,0.3)]"
        >
          Watch Match Now
        </a>
      </div>

      <div class="prose max-w-none text-left theme-text-primary">
        <h1 class="text-[#f3a833]">Watch {translateSportsData(teams)} Live on Soccer100</h1>

        <p class="theme-text-secondary leading-relaxed">
          The wait is over. <strong>{translateSportsData(teams)}</strong> is one of the most anticipated fixtures in <strong>{translateSportsData(league)}</strong> this season, and <strong>Soccer100</strong> is your #1 destination to watch every second of the action live. Scheduled for <strong>{translateSportsData(event_date_time)}</strong>, this match promises intensity, drama, and world-class football — all streamed free in HD on Soccer100 with zero registration required.
        </p>

        <h2 class="text-[#f3a833] border-b border-white/10 pb-2">
          Match Preview: {translateSportsData(teams)}
        </h2>

        <p class="theme-text-secondary">
          <strong>{strHomeTeam}</strong> and <strong>{strAwayTeam}</strong> are set to deliver a compelling contest in <strong>{translateSportsData(league)}</strong>. Both sides enter this fixture with a point to prove, and the tactical battle between the two managers could be just as captivating as the on-field action. Football fans worldwide are counting on <strong>Soccer100</strong> for smooth, high-quality <strong>soccer streams</strong> to catch every key moment.
        </p>

        <p class="theme-text-secondary">
          <strong>{strHomeTeam}</strong> will look to control the tempo and impose their style of play from the opening whistle, using their home advantage to build pressure and create chances early. Meanwhile, <strong>{strAwayTeam}</strong> arrives with a focused gameplan — compact defensively and lethal on the counter, determined to take maximum points away from home.
        </p>

        <h2 class="text-[#f3a833] border-b border-white/10 pb-2">
          Match Info Card: {translateSportsData(teams)}
        </h2>
        <div class="overflow-hidden rounded-xl border border-white/10 shadow-lg">
          <table class="w-full text-left text-sm">
            <tbody class="theme-card">
              <tr class="border-b border-white/5 hover:theme-card-hover transition-colors">
                <th class="p-4 font-black text-[#f3a833] border-r border-white/5 w-1/3">League / Tournament</th>
                <td class="p-4">{translateSportsData(league)}</td>
              </tr>
              <tr class="border-b border-white/5 hover:theme-card-hover transition-colors">
                <th class="p-4 font-black text-[#f3a833] border-r border-white/5"
                  >Matchup</th
                >
                <td class="p-4 font-bold">{translateSportsData(strHomeTeam)} vs {translateSportsData(strAwayTeam)}</td>
              </tr>
              <tr class="border-b border-white/5 hover:theme-card-hover transition-colors">
                <th class="p-4 font-black text-[#f3a833] border-r border-white/5"
                  >Kickoff Time</th
                >
                <td class="p-4">{translateSportsData(event_date_time)} ET</td>
              </tr>
              <tr class="hover:theme-card-hover transition-colors">
                <th class="p-4 font-black text-[#f3a833] border-r border-white/5">Live Coverage</th>
                <td class="p-4">Free HD soccer streams on Soccer100 — no subscription</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 class="text-[#f3a833] border-b border-white/10 pb-2 mt-8">Tactical Match Analysis</h2>

        <p class="theme-text-secondary leading-relaxed">
          <strong>{strHomeTeam}</strong> is expected to start with a high-press formation, pushing their forward line to win the ball back quickly in dangerous zones. Their attacking unit has the quality to punish any defensive lapse, and this match offers them a prime opportunity to climb the <strong>{translateSportsData(league)}</strong> standings.
        </p>

        <p class="theme-text-secondary leading-relaxed">
          <strong>{strAwayTeam}</strong> will rely on discipline and shape. Expect a deep defensive block when out of possession, with rapid transitions designed to exploit space in behind the home side's defensive line. A single moment of brilliance or set-piece could prove decisive in what looks like a tightly contested affair.
        </p>

        <h2 class="text-[#f3a833] border-b border-white/10 pb-2 mt-8">Why Soccer100 is the Best Place for Soccer Streams</h2>

        <p class="theme-text-secondary leading-relaxed">
          <strong>Soccer100</strong> has earned its reputation as the most reliable free <strong>soccer streams</strong> platform available today. For every match — including <strong>{translateSportsData(teams)}</strong> — Soccer100 provides multiple verified stream links so you always have a backup if one source drops. The interface is clean, fast, and works perfectly on mobile, tablet, and desktop without any app installation.
        </p>

        <p class="theme-text-secondary leading-relaxed">
          Whether you're catching this <strong>{translateSportsData(league)}</strong> fixture at home on a big screen or on the go with your phone, <strong>Soccer100 soccer streams</strong> deliver HD-quality coverage with minimal buffering. No sign-up, no subscription, no cost — just open Soccer100 and enjoy the game.
        </p>

      </div>
    </div>
  </div>
</Layout>
