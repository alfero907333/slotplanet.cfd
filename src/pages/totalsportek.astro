---
import Layout from "../layouts/Layout.astro";
import slugify from "../utils/slugify";

let allSports = [];
try {
  const res = await fetch(`https://spanelv2.andrhino.com/api/v2/appscheduleapi`);
  if (res.ok) {
    const data = await res.json();
    allSports = data[0].schedule.slice(0, 1);
  }
} catch (error) {
  console.error("Error fetching schedule:", error);
}

export const prerender = false;
---

<Layout
  title="Best TotalSportek Alternatives 2026 – Free Football Streams"
  description="Best TotalSportek alternatives 2026 for Premier League, Champions League, La Liga and all major football matches."
  keywords="totalsportek alternatives, best totalsportek alternatives 2026, free football streams, watch premier league free, watch champions league free"
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl sm:text-6xl font-black theme-text-primary mb-6">
        Best <span class="text-[#f3a833]">TotalSportek</span> Alternatives 2026 – Free Live Football Streams
      </h1>
      
      <div class="space-y-6 text-lg theme-text-secondary max-w-3xl mx-auto leading-relaxed">
        <p>
          TotalSportek was popular for football but many users are now switching to better platforms.
        </p>
      </div>

      <div class="mt-10">
        <a 
          href="/" 
          class="inline-block px-10 py-5 bg-[#f3a833] text-black font-black rounded-xl text-2xl transition-all hover:bg-[#e29722] hover:scale-105 shadow-2xl"
        >
          WATCH LIVE NOW →
        </a>
      </div>
    </div>

    <!-- Live Matches Placeholder Section -->
    <div class="theme-card rounded-2xl p-6 mb-16 border shadow-2xl backdrop-blur-md">
      <div class="flex items-center justify-between mb-8 border-b border-[var(--border-color)] pb-4">
        <h2 class="text-3xl font-black theme-text-primary uppercase tracking-wider">
          Live Sports Schedule
        </h2>
        <span class="animate-pulse bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase">
          Live Now
        </span>
      </div>

      <div class="space-y-4">
        {allSports.length > 0 ? (
          allSports[0].league_schedule.slice(0, 5).map((event: any) => (
            <div class="group grid grid-cols-12 items-center theme-card theme-card-hover transition-all duration-300 rounded-xl px-4 py-5 border shadow-md gap-4">
              <div class="col-span-4 flex items-center gap-3">
                <span class="theme-text-primary font-bold text-sm sm:text-lg">{event.strHomeTeam || event.teams.split(' vs ')[0]}</span>
              </div>
              <div class="col-span-4 flex flex-col items-center text-center">
                <span class="text-[10px] text-[#f3a833] font-black uppercase tracking-widest mb-1">{event.sch_league}</span>
                <span class="text-xl font-black theme-text-primary">VS</span>
              </div>
              <div class="col-span-4 flex items-center justify-end gap-3 text-right">
                <span class="theme-text-primary font-bold text-sm sm:text-lg">{event.strAwayTeam || event.teams.split(' vs ')[1]}</span>
              </div>
            </div>
          ))
        ) : (
          <div class="text-center py-10 theme-text-secondary">
            <p>Loading today's live sports matches...</p>
          </div>
        )}
      </div>
      
      <div class="text-center mt-8">
        <a href="/" class="text-[#f3a833] font-bold hover:underline transition-all">
          View All Live Matches on Homepage
        </a>
      </div>
    </div>

    <!-- Alternatives Table -->
    <div class="mb-16 overflow-x-auto">
      <h2 class="text-3xl font-black theme-text-primary mb-6">Top 8 TotalSportek Alternatives</h2>
      <table class="w-full text-left border-collapse theme-card rounded-xl overflow-hidden border shadow-xl">
        <thead class="bg-[#f3a833] text-black">
          <tr>
            <th class="p-4 font-black">Rank</th>
            <th class="p-4 font-black">Website</th>
            <th class="p-4 font-black">Best For</th>
            <th class="p-4 font-black">Quality</th>
            <th class="p-4 font-black">Score</th>
          </tr>
        </thead>
        <tbody class="theme-text-primary">
          <tr class="border-b border-[var(--border-color)]">
            <td class="p-4 font-bold">1</td>
            <td class="p-4 text-[#f3a833] font-bold">Betwoon.cfd</td>
            <td class="p-4">Football + All Sports</td>
            <td class="p-4">HD 1080p</td>
            <td class="p-4 font-black text-xl">9.6</td>
          </tr>
          <tr class="border-b border-[var(--border-color)]">
            <td class="p-4 font-bold">2</td>
            <td class="p-4">BeinMatch</td>
            <td class="p-4">Major Soccer Leagues</td>
            <td class="p-4">HD</td>
            <td class="p-4 font-black text-xl">9.2</td>
          </tr>
          <tr class="border-b border-[var(--border-color)]">
            <td class="p-4 font-bold">3</td>
            <td class="p-4">Sportsurge</td>
            <td class="p-4">Multiple Leagues</td>
            <td class="p-4">HD</td>
            <td class="p-4 font-black text-xl">8.7</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Article Sections -->
    <div class="prose prose-invert max-w-none theme-text-primary mb-16">
      <h2 class="text-3xl font-black text-[#f3a833]">1. Betwoon.cfd (Best TotalSportek Alternative)</h2>
      <p class="text-lg leading-relaxed">
        Betwoon.cfd offers fast updates, multiple stream links, and excellent coverage of football matches.
      </p>
    </div>

    <!-- Final Call to Action -->
    <div class="theme-card p-12 rounded-3xl text-center shadow-2xl border border-white/5 bg-gradient-to-b from-white/5 to-transparent">
      <h2 class="text-4xl font-black mb-6 theme-text-primary">Don't Miss Another Second of the Action</h2>
      <p class="text-xl theme-text-secondary mb-10 max-w-2xl mx-auto">
        Whether it's the playoffs or a regular-season game, Soccer100 has you covered. Get direct access to the fastest sports feeds online right now.
      </p>
      <a 
        href="/" 
        class="inline-block px-12 py-6 bg-[#f3a833] text-black font-black rounded-2xl text-3xl transition-all hover:bg-[#e29722] hover:scale-105 shadow-2xl"
      >
        GO TO SOCCER100 NOW
      </a>
      <div class="mt-8">
        <a href="/" class="theme-text-secondary hover:text-[#f3a833] transition-colors font-medium">
          ← Return to Soccer100 Homepage
        </a>
      </div>
    </div>
  </div>
</Layout>