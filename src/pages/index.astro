<script is:inline>
  const searchInput = document.getElementById('match-search');
  const sportSections = document.querySelectorAll('.sport-section');
  const noMatchesMsg = document.getElementById('no-matches-found');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const searchTerm = e.target.value.toLowerCase().trim();
      let hasAnyMatches = false;

      sportSections.forEach(section => {
        const cards = section.querySelectorAll('.match-card');
        let hasMatchesInSection = false;

        cards.forEach(card => {
          const searchData = card.getAttribute('data-search');
          if (searchData.includes(searchTerm)) {
            card.classList.remove('hidden');
            card.classList.add('grid');
            hasMatchesInSection = true;
            hasAnyMatches = true;
          } else {
            card.classList.remove('grid');
            card.classList.add('hidden');
          }
        });

        if (hasMatchesInSection) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });

      if (hasAnyMatches) {
        noMatchesMsg.classList.add('hidden');
      } else {
        noMatchesMsg.classList.remove('hidden');
      }
    });
  }
</script>
