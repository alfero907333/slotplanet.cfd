---
import Layout from "../layouts/Layout.astro";
import slugify from "../utils/slugify";


let allSports = [];
try {
  const res = await fetch(`https://spanelv2.andrhino.com/api/v2/appscheduleapi`);
  if (res.ok) {
    const data = await res.json();
    const sportsData = data[0].schedule;
    
    // Move Soccer (sport_id 3) to the top
    const soccerIdx = sportsData.findIndex((s: any) => s.sport_id === 3);
    if (soccerIdx > -1) {
      const soccer = sportsData.splice(soccerIdx, 1)[0];
      allSports = [soccer, ...sportsData];
    } else {
      allSports = sportsData;
    }
  }
} catch (error) {
  console.error("Error fetching schedule:", error);
}



const SHOW_ADS = import.meta.env.SHOW_ADS === "true";

export const prerender = false;
