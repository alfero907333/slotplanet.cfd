---
import Layout from "../layouts/Layout.astro";
const SITE_NAME = import.meta.env.SITE_NAME || "Site Name";
---

<Layout
  title={`${SITE_NAME} - Contact Us | Rojadirecta, FootyBite & Soccer Streams`}
  description={`Contact ${SITE_NAME} (Rojadirecta, FootyBite & Soccer Streams) for any inquiries or support.`}
  keywords={`${SITE_NAME}, Rojadirecta, FootyBite, Soccer Streams, Contact Us`}
>
  <div class="max-w-4xl mx-auto text-left">
    <div class="mx-3 prose max-w-none theme-text-primary p-8">
      <div>
        <h1>Contact Us</h1><p>
          Email: admin@{
            (Astro.site?.toString() || Astro.url.origin).replace(
              /^https?:\/\//,
              "",
            )
          }
        </p>
      </div>
    </div>
  </div>
</Layout>
