      <div class="overflow-x-auto my-8">
        <table class="w-full border-collapse border border-white/10 text-sm sm:text-base">
          <thead>
            <tr class="bg-white/5">
              <th class="border border-white/10 p-3 text-left">Feature</th>
              <th class="border border-white/10 p-3 text-left text-[#f3a833]">Soccer100</th>
