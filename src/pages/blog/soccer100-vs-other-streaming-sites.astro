              <td class="border border-white/10 p-3 text-[#f3a833]">✅ Clean</td>
              <td class="border border-white/10 p-3">❌ Heavy pop-ups</td>
            </tr>
            <tr>
              <td class="border border-white/10 p-3">Multi-Sport Coverage</td>
              <td class="border border-white/10 p-3 text-[#f3a833]">✅ Soccer/MLB/NBA/NHL</td>
              <td class="border border-white/10 p-3">❌ Soccer only</td>
            </tr>
            <tr>
              <td class="border border-white/10 p-3">Stream Reliability</td>
              <td class="border border-white/10 p-3 text-[#f3a833]">✅ High</td>
              <td class="border border-white/10 p-3">⚠️ Inconsistent</td>
            </tr>
            <tr>
              <td class="border border-white/10 p-3">Cost</td>
              <td class="border border-white/10 p-3 text-[#f3a833]">✅ Free</td>
              <td class="border border-white/10 p-3">✅ Free</td>
            </tr>
            <tr>
              <td class="border border-white/10 p-3">Global League Coverage</td>
              <td class="border border-white/10 p-3 text-[#f3a833]">✅ All major leagues</td>
              <td class="border border-white/10 p-3">⚠️ Limited</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-2xl font-bold text-[#f3a833] mt-10 mb-4">Where Soccer100 Wins</h2>
      
      <h3 class="text-xl font-bold text-[#f3a833] mt-8 mb-3">1. Daily Updated Match Schedules</h3>
