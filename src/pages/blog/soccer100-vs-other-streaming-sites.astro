          </thead>
          <tbody>
            <tr>
              <td class="border border-white/10 p-3">Daily Schedule Updates</td>
              <td class="border border-white/10 p-3 text-[#f3a833]">✅ Yes</td>
              <td class="border border-white/10 p-3">❌ Often outdated</td>
            </tr>
            <tr>
              <td class="border border-white/10 p-3">Mobile Friendly</td>
              <td class="border border-white/10 p-3 text-[#f3a833]">✅ Fully optimized</td>
              <td class="border border-white/10 p-3">⚠️ Hit or miss</td>
            </tr>
            <tr>
              <td class="border border-white/10 p-3">Registration Required</td>
