      {posts.map(post => (
        <a href={post.url} class="group block">
          <div class="theme-card p-8 rounded-2xl border border-white/10 shadow-xl transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl hover:border-[#f3a833]/30">
            <div class="flex justify-between items-start mb-4">
              <span class="text-xs font-bold text-[#f3a833] uppercase tracking-widest bg-[#f3a833]/10 px-3 py-1 rounded-full">
                {post.category}
              </span>
              <span class="text-sm theme-text-secondary font-medium">
                {post.date}
              </span>
            </div>
            <h2 class="text-2xl font-black theme-text-primary mb-3 group-hover:text-[#f3a833] transition-colors">
