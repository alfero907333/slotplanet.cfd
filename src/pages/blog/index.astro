---
import Layout from "../../layouts/Layout.astro";

const title = "Rojadirecta | Footybite | Methstreams – Sports Blog";
const description = "Read the latest sports streaming guides. Find the best Methstreams, Rojadirecta, and Buffstreams mirrors to watch live sports in HD for free.";
const keywords = "Rojadirecta, Footybite, Methstreams, sports blog, live streaming guides";

const posts = [
  {
    title: "Footybite Premier League: Rojadirecta & MethStreams HD",
    description: "Watch Premier League live on Footybite, Rojadirecta & MethStreams. HD soccer streams with no signup. Best EPL coverage for 2026 fans.",
    url: "/blog/footybite-premier-league/",
    date: "June 09, 2026",
    category: "Premier League"
  },
  {
    title: "Rojadirecta, Footybite & MethStreams: 2026 Guide",
    description: "The ultimate 2026 guide to Rojadirecta, Footybite, and MethStreams. Learn how to find the best free live sports streams in HD safely and quickly.",
    url: "/blog/rojadirecta-footybite-guide/",
    date: "June 08, 2026",
    category: "Streaming Guide"
  },
  {
    title: "MethStreams NFL: Rojadirecta & Footybite Live HD",
    description: "Stream NFL live on MethStreams, Rojadirecta & Footybite. High-speed HD football streams with no signup. Your ultimate 2026 NFL guide.",
    url: "/blog/methstreams-nfl-streams/",
    date: "June 07, 2026",
    category: "NFL"
  }
];
---

<Layout title={title} description={description} keywords={keywords}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-black theme-text-primary mb-4">
        Rojadirecta <span class="text-[#f3a833]">Blog</span>
      </h1>
      <p class="theme-text-secondary text-xl max-w-2xl mx-auto">
        Your ultimate guide to the world of live football streaming and FootyBite.
      </p>
    </div>

    <div class="grid gap-8">
      {posts.map(post => (
        <a href={post.url} class="group block">
          <div class="theme-card p-8 rounded-2xl border border-white/10 shadow-xl transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl hover:border-[#f3a833]/30">
            <div class="flex justify-between items-start mb-4">
              <span class="text-xs font-bold text-[#f3a833] uppercase tracking-widest bg-[#f3a833]/10 px-3 py-1 rounded-full">
                {post.category}
              </span>
              <span class="text-sm theme-text-secondary font-medium">
                {post.date}
              </span>
            </div>
            <h2 class="text-2xl font-black theme-text-primary mb-3 group-hover:text-[#f3a833] transition-colors">
              {post.title}
            </h2>
            <p class="theme-text-secondary leading-relaxed mb-6">
              {post.description}
            </p>
            <div class="flex items-center text-[#f3a833] font-bold gap-2">
              Read Article 
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
