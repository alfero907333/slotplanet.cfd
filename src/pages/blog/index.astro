---
import Layout from "../../layouts/Layout.astro";

const title = "Rojadirecta Blog: Guides to Free FootyBite";
const description = "Read the latest Rojadirecta blog guides. Find robust FootyBite and stable Soccer Streams mirrors to watch live football in high definition for free.";
const keywords = "rojadirecta blog, footybite, soccer streams, football streaming guides";

const posts = [
  {
    title: "Methstreams Premier League: HD Buffstreams & Match Coverage",
    description: "Access premium Methstreams Premier League links and match coverage. Watch every EPL fixture live via Buffstreams in HD. Your guide to 2026 football.",
    url: "/blog/footybite-premier-league/",
    date: "June 09, 2026",
    category: "Premier League"
  },
  {
    title: "Methstreams vs Rojadirecta vs Buffstreams: 2026 Guide",
    description: "The ultimate guide to Methstreams, Rojadirecta, and Buffstreams. Learn how to access HD sports safely and find the best free live streams online for 2026.",
    url: "/blog/rojadirecta-footybite-guide/",
    date: "June 08, 2026",
    category: "Guide"
  },
  {
    title: "Methstreams NFL: Live HD Buffstreams & Season Guide",
    description: "Find the best Methstreams NFL mirrors and season-long coverage. Watch every touchdown live via Buffstreams in HD. Your guide to 2026 NFL streams.",
    url: "/blog/methstreams-nfl-streams/",
    date: "June 07, 2026",
    category: "NFL"
  }
];
---

<Layout title={title} description={description} keywords={keywords}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-black theme-text-primary mb-4">
        Rojadirecta <span class="text-[#f3a833]">Blog</span>
      </h1>
      <p class="theme-text-secondary text-xl max-w-2xl mx-auto">
        Your ultimate guide to the world of live football streaming and FootyBite.
      </p>
    </div>

    <div class="grid gap-8">
      {posts.map(post => (
        <a href={post.url} class="group block">
          <div class="theme-card p-8 rounded-2xl border border-white/10 shadow-xl transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl hover:border-[#f3a833]/30">
            <div class="flex justify-between items-start mb-4">
              <span class="text-xs font-bold text-[#f3a833] uppercase tracking-widest bg-[#f3a833]/10 px-3 py-1 rounded-full">
                {post.category}
              </span>
              <span class="text-sm theme-text-secondary font-medium">
                {post.date}
              </span>
            </div>
            <h2 class="text-2xl font-black theme-text-primary mb-3 group-hover:text-[#f3a833] transition-colors">
              {post.title}
            </h2>
            <p class="theme-text-secondary leading-relaxed mb-6">
              {post.description}
            </p>
            <div class="flex items-center text-[#f3a833] font-bold gap-2">
              Read Article 
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
