---
const SITE_NAME = "Rojadirecta";
import slugify from "../../utils/slugify";

let sports = [];
try {
  const res = await fetch("https://spanelv2.andrhino.com/api/v2/appscheduleapi");
  if (res.ok) {
    const data = await res.json();
    const sportsData = data[0].schedule;
    const soccerIdx = sportsData.findIndex((s) => s.sport_id === 3);
    if (soccerIdx > -1) {
      const soccer = sportsData.splice(soccerIdx, 1)[0];
      sports = [soccer, ...sportsData];
    } else {
      sports = sportsData;
    }
  }
} catch (e) {
  // silent error
}
---
<nav class="theme-nav border-b border-[var(--border-color)] shadow-md">
  <div class="mx-3">
    <div class="mx-auto max-w-4xl flex items-center justify-between gap-4 py-2 border-b border-[var(--border-color)]">
      <div class="flex items-center gap-4">
        <a href="/" class="group flex items-center gap-3 transition-transform hover:scale-105">
            <div class="bg-[#f3a833] p-2 rounded-xl shadow-[0_0_20px_rgba(243,168,51,0.3)] group-hover:shadow-[0_0_30px_rgba(243,168,51,0.5)] transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                <path d="M4 22h16"></path>
                <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
              </svg>
            </div>
            <span class="text-2xl font-black tracking-tighter theme-text-primary italic uppercase">
              Roja<span class="text-[#f3a833]">directa</span>
            </span>
          </a>
        </div>
        
        <div class="flex items-center gap-4">
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Switch to light mode"
            aria-pressed="false"
          >
            <span class="theme-toggle-track" aria-hidden="true">
              <span class="theme-toggle-icon theme-toggle-icon-sun">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm0-16a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 18a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1ZM4.22 5.64a1 1 0 0 1 1.42 0l1.4 1.41a1 1 0 0 1-1.41 1.42l-1.41-1.42a1 1 0 0 1 0-1.41Zm12.73 12.73a1 1 0 0 1 1.41 0l1.42 1.41a1 1 0 0 1-1.42 1.42l-1.41-1.42a1 1 0 0 1 0-1.41ZM20 11a1 1 0 1 1 0 2h-2a1 1 0 1 1 0-2h2ZM6 11a1 1 0 1 1 0 2H4a1 1 0 1 1 0-2h2Zm13.78-5.36a1 1 0 0 1 0 1.41l-1.42 1.42a1 1 0 0 1-1.41-1.42l1.41-1.41a1 1 0 0 1 1.42 0ZM7.05 18.37a1 1 0 0 1 0 1.41l-1.41 1.42a1 1 0 1 1-1.42-1.42l1.42-1.41a1 1 0 0 1 1.41 0Z"/>
                </svg>
              </span>
              <span class="theme-toggle-icon theme-toggle-icon-moon">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M21 12.79A9 9 0 0 1 11.21 3c0-.45.04-.89.1-1.32a1 1 0 0 0-1.37-1.07A10 10 0 1 0 23.39 14.06 1 1 0 0 0 22.32 12.7c-.43.06-.87.09-1.32.09Z"/>
                </svg>
              </span>
              <span class="theme-toggle-thumb"></span>
            </span>
            <span class="theme-toggle-label">Dark</span>
          </button>
        </div>

      <div class="flex items-center gap-2 ml-auto">
        <div class="relative max-w-[150px] sm:max-w-xs">
          <input type="text" id="match-search" placeholder="Search..." class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-full py-2 px-4 theme-text-primary text-xs sm:text-sm focus:outline-none focus:border-[#f3a833]/50" />
        </div>
        <a href="https://discord.gg/uSUvWPNjCW" target="_blank" class="p-2 rounded-full bg-[#5865F2] text-white flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M13.545 2.907a13.227 13.227 0 0 0-3.257-1.011.05.05 0 0 0-.052.025c-.141.25-.297.577-.406.833a12.19 12.19 0 0 0-3.658 0 8.258 8.258 0 0 0-.412-.833.051.051 0 0 0-.052-.025c-1.125.194-2.22.534-3.257 1.011a.041.041 0 0 0-.021.018C.356 6.024-.213 9.047.066 12.032c.001.014.01.028.021.037a13.276 13.276 0 0 0 3.995 2.02.05.05 0 0 0 .056-.019c.308-.42.582-.863.818-1.329a.05.05 0 0 0-.01-.059.051.051 0 0 0-.018-.011 8.875 8.875 0 0 1-1.248-.595.05.05 0 0 1-.02-.066.051.051 0 0 1 .015-.019c.084-.063.168-.129.248-.195a.05.05 0 0 1 .051-.007c2.619 1.196 5.454 1.196 8.041 0a.052.052 0 0 1 .053.007c.08.066.164.132.248.195a.051.051 0 0 1-.004.085 8.254 8.254 0 0 1-1.248.595.05.05 0 0 0-.023.07c.236.466.51.909.818 1.329a.05.05 0 0 0 .056.019 13.235 13.235 0 0 0 4.001-2.02.049.049 0 0 0 .021-.037c.334-3.451-.559-6.449-2.366-9.106a.034.034 0 0 0-.02-.019Zm-8.198 7.307c-.789 0-1.438-.724-1.438-1.612 0-.889.637-1.613 1.438-1.613.807 0 1.45.73 1.438 1.613 0 .888-.637 1.612-1.438 1.612Zm5.316 0c-.788 0-1.438-.724-1.438-1.612 0-.889.637-1.613 1.438-1.613.807 0 1.451.73 1.438 1.613 0 .888-.631 1.612-1.438 1.612Z"/>
          </svg>
        </a>
      </div>
    </div>

    {sports.length > 0 && (
      <div class="mx-auto max-w-4xl py-3 overflow-x-auto no-scrollbar scroll-smooth">
        <div class="flex items-center gap-3 whitespace-nowrap px-1">
          {sports.map((sport) => (
            <a 
              href={`/#${slugify(sport.sport)}`} 
              class="relative px-6 py-2.5 rounded-xl text-xs sm:text-sm font-black uppercase tracking-widest border border-white/5 theme-card hover:border-[#f3a833]/50 hover:bg-[#f3a833] hover:text-black hover:scale-105 transition-all duration-300 shadow-lg flex items-center gap-2 group overflow-hidden"
            >
              <span class="w-2 h-2 rounded-full bg-[#f3a833] group-hover:bg-black transition-colors animate-pulse"></span>
              {sport.sport}
              <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
            </a>
          ))}
          <a href="/blog/" class="px-6 py-2.5 rounded-xl text-xs sm:text-sm font-black uppercase tracking-widest border border-[#f3a833] text-[#f3a833] theme-card hover:bg-[#f3a833] hover:text-black hover:scale-105 transition-all duration-300 shadow-lg flex items-center gap-2 group overflow-hidden">
            <span class="w-2 h-2 rounded-full bg-[#f3a833] group-hover:bg-black transition-colors animate-pulse"></span>
            Blog
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
          </a>
        </div>
      </div>
    )}
  </div>
</nav>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }
  .animate-shimmer {
    animation: shimmer 1.5s infinite;
  }
</style>

<script is:inline>
  const t = document.getElementById('theme-toggle');
  const themeLabel = t?.querySelector('.theme-toggle-label');

  const syncThemeToggle = () => {
    if (!t || !themeLabel) return;

    const isLight = document.documentElement.classList.contains('light');
    t.setAttribute('aria-pressed', String(isLight));
    t.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
    themeLabel.textContent = isLight ? 'Light' : 'Dark';
  };

  syncThemeToggle();

  if (t) {
    t.addEventListener('click', () => {
      document.documentElement.classList.toggle('light');
      localStorage.setItem('theme', document.documentElement.classList.contains('light') ? 'light' : 'dark');
      syncThemeToggle();
    });
  }
</script>
