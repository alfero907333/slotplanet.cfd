---
const SITE_NAME = "Soccer100";
import slugify from "../../utils/slugify";

let sports = [];
try {
  const res = await fetch("https://spanelv2.andrhino.com/api/v2/appscheduleapi");
  if (res.ok) {
    const data = await res.json();
    const sportsData = data[0].schedule;
    const soccerIdx = sportsData.findIndex((s) => s.sport_id === 3);
    if (soccerIdx > -1) {
      const soccer = sportsData.splice(soccerIdx, 1)[0];
      sports = [soccer, ...sportsData];
    } else {
      sports = sportsData;
    }
  }
} catch (e) {
  // silent error
}
---
<nav class="theme-nav border-b border-[var(--border-color)] shadow-md">
  <div class="mx-3">
    <div class="mx-auto max-w-4xl flex items-center justify-between gap-4 py-2 border-b border-[var(--border-color)]">
      <div class="flex items-center gap-4">
        <a href="/" class="text-xl font-bold bg-[#f3a833] px-4 py-2 rounded-md text-black flex items-center gap-2">
            <span>{SITE_NAME}</span>
          </a>
        </div>
        
        <div class="flex items-center gap-4">
          <button
            id="theme-toggle"
            class="relative inline-flex h-9 w-18 items-center rounded-full transition-all duration-500 focus:outline-none overflow-hidden group border-2 border-slate-700/50 shadow-inner bg-slate-800"
            aria-label="Toggle Theme"
          >
            <!-- Background Layers (Track) -->
            <div class="absolute inset-0 transition-colors duration-500 bg-slate-900 [.light_&]:bg-sky-400"></div>
            
            <!-- Clouds (Light Mode Track Decoration) -->
            <div class="absolute inset-0 transition-opacity duration-500 opacity-0 [.light_&]:opacity-100 pointer-events-none">
              <div class="absolute top-1 left-4 w-2 h-1 bg-white rounded-full opacity-40"></div>
              <div class="absolute top-4 left-2 w-3 h-1.5 bg-white rounded-full opacity-30"></div>
              <div class="absolute top-2 right-4 w-4 h-2 bg-white rounded-full opacity-50"></div>
            </div>

            <!-- Stars (Dark Mode Track Decoration) -->
            <div class="absolute inset-0 transition-opacity duration-500 opacity-100 [.light_&]:opacity-0 pointer-events-none">
              <div class="absolute top-2 left-6 w-0.5 h-0.5 bg-white rounded-full animate-pulse"></div>
              <div class="absolute top-5 left-4 w-1 h-1 bg-white rounded-full animate-pulse [animation-delay:0.5s]"></div>
              <div class="absolute top-3 right-8 w-0.5 h-0.5 bg-white rounded-full animate-pulse [animation-delay:1s]"></div>
            </div>

            <!-- Static Icons in Track (Both visible) -->
            <!-- Sun Icon (Left) -->
            <div class="absolute left-1.5 z-10 transition-all duration-500 [.light_&]:scale-110 [.light_&]:opacity-100 opacity-40">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-500 [.light_&]:text-yellow-600">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
            </div>

            <!-- Moon Icon (Right) -->
            <div class="absolute right-1.5 z-10 transition-all duration-500 [html:not(.light)_&]:scale-110 [html:not(.light)_&]:opacity-100 opacity-40">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-purple-400 [html:not(.light)_&]:text-purple-300">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
            </div>

            <!-- Slider (The Highlight) -->
            <div
              class="relative z-20 inline-block h-7 w-7 transform rounded-full transition-all duration-500 cubic-bezier(0.34, 1.56, 0.64, 1) translate-x-10 [.light_&]:translate-x-1 shadow-[0_0_15px_rgba(255,255,255,0.3)] [.light_&]:shadow-[0_0_15px_rgba(243,168,51,0.5)] flex items-center justify-center bg-white/20 backdrop-blur-[2px] border border-white/30"
            >
              <!-- This slider is now a "highlight" frame that moves over the static icons -->
              <div class="w-full h-full rounded-full border-2 border-white/50 [.light_&]:border-yellow-400/50 shadow-inner"></div>
            </div>
          </button>
        </div>

      <div class="flex items-center gap-2 ml-auto">
        <div class="relative max-w-[150px] sm:max-w-xs">
          <input type="text" id="match-search" placeholder="Search..." class="w-full bg-[var(--card-bg)] border border-[var(--border-color)] rounded-full py-2 px-4 theme-text-primary text-xs sm:text-sm focus:outline-none focus:border-[#f3a833]/50" />
        </div>
        <a href="https://discord.gg/uSUvWPNjCW" target="_blank" class="p-2 rounded-full bg-[#5865F2] text-white flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M13.545 2.907a13.227 13.227 0 0 0-3.257-1.011.05.05 0 0 0-.052.025c-.141.25-.297.577-.406.833a12.19 12.19 0 0 0-3.658 0 8.258 8.258 0 0 0-.412-.833.051.051 0 0 0-.052-.025c-1.125.194-2.22.534-3.257 1.011a.041.041 0 0 0-.021.018C.356 6.024-.213 9.047.066 12.032c.001.014.01.028.021.037a13.276 13.276 0 0 0 3.995 2.02.05.05 0 0 0 .056-.019c.308-.42.582-.863.818-1.329a.05.05 0 0 0-.01-.059.051.051 0 0 0-.018-.011 8.875 8.875 0 0 1-1.248-.595.05.05 0 0 1-.02-.066.051.051 0 0 1 .015-.019c.084-.063.168-.129.248-.195a.05.05 0 0 1 .051-.007c2.619 1.196 5.454 1.196 8.041 0a.052.052 0 0 1 .053.007c.08.066.164.132.248.195a.051.051 0 0 1-.004.085 8.254 8.254 0 0 1-1.248.595.05.05 0 0 0-.023.07c.236.466.51.909.818 1.329a.05.05 0 0 0 .056.019 13.235 13.235 0 0 0 4.001-2.02.049.049 0 0 0 .021-.037c.334-3.451-.559-6.449-2.366-9.106a.034.034 0 0 0-.02-.019Zm-8.198 7.307c-.789 0-1.438-.724-1.438-1.612 0-.889.637-1.613 1.438-1.613.807 0 1.45.73 1.438 1.613 0 .888-.637 1.612-1.438 1.612Zm5.316 0c-.788 0-1.438-.724-1.438-1.612 0-.889.637-1.613 1.438-1.613.807 0 1.451.73 1.438 1.613 0 .888-.631 1.612-1.438 1.612Z"/>
          </svg>
        </a>
      </div>
    </div>

    {sports.length > 0 && (
      <div class="mx-auto max-w-4xl py-2 overflow-x-auto no-scrollbar scroll-smooth">
        <div class="flex items-center gap-2 whitespace-nowrap px-1">
          {sports.map((sport) => (
            <a href={`/#${slugify(sport.sport)}`} class="px-5 py-2 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wider border border-[var(--border-color)] theme-card hover:border-[#f3a833] hover:text-[#f3a833] transition-all shadow-sm">
              {sport.sport}
            </a>
          ))}
          <a href="/blog/" class="px-5 py-2 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wider border border-[#f3a833] text-[#f3a833] theme-card hover:bg-[#f3a833] hover:text-black transition-all shadow-sm">
            Blog
          </a>
        </div>
      </div>
    )}
  </div>
</nav>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script is:inline>
  const t = document.getElementById('theme-toggle');
  if (t) {
    t.addEventListener('click', () => {
      document.documentElement.classList.toggle('light');
      localStorage.setItem('theme', document.documentElement.classList.contains('light') ? 'light' : 'dark');
    });
  }
</script>
