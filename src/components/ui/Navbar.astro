---
const SITE_NAME = "Soccer100";
import slugify from "../../utils/slugify";

let sports = [];
try {
  const res = await fetch("https://spanelv2.andrhino.com/api/v2/appscheduleapi");
  if (res.ok) {
    const data = await res.json();
    const sportsData = data[0].schedule;
    const soccerIdx = sportsData.findIndex((s) => s.sport_id === 3);
    if (soccerIdx > -1) {
      const soccer = sportsData.splice(soccerIdx, 1)[0];
      sports = [soccer, ...sportsData];
    } else {
      sports = sportsData;
    }
  }
} catch (e) {
  // silent error
}
---
<nav class="theme-nav border-b border-white/5 shadow-md">
  <div class="mx-3">
    <div class="mx-auto max-w-4xl flex items-center justify-between gap-4 py-2 border-b border-white/5">
      <div class="flex items-center gap-4">
        <a href="/" class="text-xl font-bold bg-[#f3a833] px-4 py-2 rounded-md text-black flex items-center gap-2">
          <span>{SITE_NAME}</span>
        </a>
        <button id="theme-toggle" class="p-2 rounded-lg bg-neutral-200/20 theme-text-primary" aria-label="Toggle Theme">
          🌓
        </button>
      </div>

      <div class="flex items-center gap-2 ml-auto">
        <div class="relative max-w-[150px] sm:max-w-xs">
          <input type="text" id="match-search" placeholder="Search..." class="w-full bg-neutral-200/10 border border-white/10 rounded-full py-2 px-4 theme-text-primary text-xs sm:text-sm focus:outline-none focus:border-[#f3a833]/50" />
        </div>
        <a href="https://discord.gg/uSUvWPNjCW" target="_blank" class="p-2 rounded-full bg-[#5865F2] text-white flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M13.545 2.907a13.227 13.227 0 0 0-3.257-1.011.05.05 0 0 0-.052.025c-.141.25-.297.577-.406.833a12.19 12.19 0 0 0-3.658 0 8.258 8.258 0 0 0-.412-.833.051.051 0 0 0-.052-.025c-1.125.194-2.22.534-3.257 1.011a.041.041 0 0 0-.021.018C.356 6.024-.213 9.047.066 12.032c.001.014.01.028.021.037a13.276 13.276 0 0 0 3.995 2.02.05.05 0 0 0 .056-.019c.308-.42.582-.863.818-1.329a.05.05 0 0 0-.01-.059.051.051 0 0 0-.018-.011 8.875 8.875 0 0 1-1.248-.595.05.05 0 0 1-.02-.066.051.051 0 0 1 .015-.019c.084-.063.168-.129.248-.195a.05.05 0 0 1 .051-.007c2.619 1.196 5.454 1.196 8.041 0a.052.052 0 0 1 .053.007c.08.066.164.132.248.195a.051.051 0 0 1-.004.085 8.254 8.254 0 0 1-1.248.595.05.05 0 0 0-.023.07c.236.466.51.909.818 1.329a.05.05 0 0 0 .056.019 13.235 13.235 0 0 0 4.001-2.02.049.049 0 0 0 .021-.037c.334-3.451-.559-6.449-2.366-9.106a.034.034 0 0 0-.02-.019Zm-8.198 7.307c-.789 0-1.438-.724-1.438-1.612 0-.889.637-1.613 1.438-1.613.807 0 1.45.73 1.438 1.613 0 .888-.637 1.612-1.438 1.612Zm5.316 0c-.788 0-1.438-.724-1.438-1.612 0-.889.637-1.613 1.438-1.613.807 0 1.451.73 1.438 1.613 0 .888-.631 1.612-1.438 1.612Z"/>
          </svg>
        </a>
      </div>
    </div>

    {sports.length > 0 && (
      <div class="mx-auto max-w-4xl py-2 overflow-x-auto no-scrollbar scroll-smooth">
        <div class="flex items-center gap-2 whitespace-nowrap px-1">
          {sports.map((sport) => (
            <a href={`/#${slugify(sport.sport)}`} class="px-5 py-2 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wider border border-white/10 theme-card hover:border-[#f3a833] hover:text-[#f3a833] transition-all shadow-sm">
              {sport.sport}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</nav>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script is:inline>
  const t = document.getElementById('theme-toggle');
  if (t) {
    t.addEventListener('click', () => {
      document.documentElement.classList.toggle('light');
      localStorage.setItem('theme', document.documentElement.classList.contains('light') ? 'light' : 'dark');
    });
  }
</script>
