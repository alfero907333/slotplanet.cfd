---
// Footer.astro
const SITE_NAME = import.meta.env.SITE_NAME || "Site Name";
---

<footer class="bg-gray-900 border-t border-white/10 mt-20">
  <div
    class="max-w-7xl mx-auto px-4 py-10 flex flex-col md:flex-row justify-between items-center gap-6"
  >
    <!-- SITE INFO -->
    <div class="text-center md:text-left">
      <h2 class="text-xl font-semibold text-brand tracking-wide">
        {SITE_NAME}
      </h2>
      <p class="text-neutral-400 text-sm mt-1">
        © 2026 {SITE_NAME}. All rights reserved. Built for seamless sports
        streaming access.
      </p>
    </div>

    <!-- QUICK LINKS -->
    <nav class="flex flex-wrap justify-center gap-5 text-sm text-neutral-300">
      <a href="/" class="hover:text-brand transition duration-200">Home</a>
      <a href="/contact-us/" class="hover:text-brand transition duration-200"
        >Contact</a
      >
      <a
        href="/privacy-policy/"
        class="hover:text-brand transition duration-200">Privacy</a
      >
      <a href="/dmca/" class="hover:text-brand transition duration-200">DMCA</a>
    </nav>
  </div>
</footer>
