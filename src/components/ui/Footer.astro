---
// Footer.astro
const SITE_NAME = import.meta.env.SITE_NAME || "Site Name";
---

<footer class="theme-nav border-t border-[var(--border-color)] mt-20 shadow-inner">
  <div
    class="max-w-7xl mx-auto px-4 py-10 flex flex-col md:flex-row justify-between items-center gap-6"
  >
    <!-- SITE INFO -->
    <div class="text-center md:text-left">
      <h2 class="text-xl font-semibold text-brand tracking-wide">
        {SITE_NAME}
      </h2>
      <p class="theme-text-secondary text-sm mt-1">
        © 2026 {SITE_NAME} & Soccer Streams. All rights reserved. Your #1 source for live football streaming.
      </p>
    </div>

    <!-- QUICK LINKS -->
    <nav class="flex flex-wrap justify-center gap-5 text-sm theme-text-secondary">
      <a href="/" class="hover:text-brand transition duration-200">Home</a>
      <a href="/contact-us/" class="hover:text-brand transition duration-200"
        >Contact Us</a
      >
      <a
        href="/privacy-policy/"
        class="hover:text-brand transition duration-200">Privacy Policy</a
      >
      <a href="/dmca/" class="hover:text-brand transition duration-200">DMCA</a>
    </nav>
  </div>
</footer>
